[Exists([P_0, P_1, P_2, P_3, I_0, I_1, I_2, I_3, B],
        And(L_0 >= 0,
            L_0 >= L0,
            L0 >= 0,
            I_0 <= A_0 - L_0,
            C >= 5*a,
            B >= 5*a,
            a == 1,
            Implies(A_1 - L_0 - I_1 > B,
                    L_1 == A_1 - I_1 - B),
            Implies(Not(A_1 - L_0 - I_1 > B), L_1 == L_0),
            Implies(A_2 - L_1 - I_2 > B,
                    L_2 == A_2 - I_2 - B),
            Implies(Not(A_2 - L_1 - I_2 > B), L_2 == L_1),
            Implies(A_3 - L_2 - I_3 > B,
                    L_3 == A_3 - I_3 - B),
            Implies(Not(A_3 - L_2 - I_3 > B), L_3 == L_2),
            K > 0,
            pert > 0,
            K < pert*B,
            P_0 >= A_0 - K,
            P_0 <= A_0,
            P_1 >= A_1 - K,
            P_1 <= A_1,
            P_2 >= A_2 - K,
            P_2 <= A_2,
            P_3 >= A_3 - K,
            P_3 <= A_3,
            I_1 ==
            If(I_0 + C*1 < P_1 - L_1, I_0 + C*1, P_1 - L_1),
            I_2 ==
            If(I_1 + C*1 < P_2 - L_2, I_1 + C*1, P_2 - L_2),
            I_3 ==
            If(I_2 + C*1 < P_3 - L_3, I_2 + C*1, P_3 - L_3),
            S_0 >= I_0 - C*1,
            S_0 <= I_0,
            S_1 >= I_0,
            S_1 >= S_0,
            S_1 <= I_1,
            S_2 >= I_1,
            S_2 >= S_1,
            S_2 <= I_2,
            S_3 >= I_2,
            S_3 >= S_2,
            S_3 <= I_3,
            A_1 >= A_0,
            A_2 >= A_1,
            A_3 >= A_2,
            A_3 - L_3 <= S_3))]